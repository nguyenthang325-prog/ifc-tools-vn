<?xml version='1.0' encoding='utf-8'?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
    <info>
        <title>EIR Nha pho mau — MEP — TKTC</title>
        <description>Sinh từ QĐ 347/QĐ-BXD. Thước đo chấm bằng máy theo chuẩn buildingSMART IDS.</description>
        <date>2026-07-23</date>
        <purpose>Đặc tả yêu cầu thông tin (EIR) — bộ môn MEP, giai đoạn TKTC</purpose>
    </info>
    <specifications>
        <specification name="EIR-PRJ-01 — IfcProject phải có Tên dự án" ifcVersion="IFC2X3 IFC4" identifier="EIR-PRJ-01" instructions="Yêu cầu áp dụng từ giai đoạn TKCS (bộ môn ALL).">
            <applicability minOccurs="0" maxOccurs="unbounded">
                <entity>
                    <name>
                        <simpleValue>IFCPROJECT</simpleValue>
                    </name>
                </entity>
            </applicability>
            <requirements>
                <attribute cardinality="required">
                    <name>
                        <simpleValue>Name</simpleValue>
                    </name>
                </attribute>
            </requirements>
        </specification>
