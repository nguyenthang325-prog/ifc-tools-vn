        <purpose>Đặc tả yêu cầu thông tin (EIR) — bộ môn KC, giai đoạn TKTC</purpose>
    </info>
    <specifications>
        <specification name="EIR-PRJ-01 — IfcProject phải có Tên dự án" ifcVersion="IFC2X3 IFC4" identifier="EIR-PRJ-01" instructions="Yêu cầu áp dụng từ giai đoạn TKCS (bộ môn ALL).">
